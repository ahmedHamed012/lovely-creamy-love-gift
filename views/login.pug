extends layout

block title
  | #{config.loginTabTitle}

block head
  link(rel="stylesheet" href="/css/login.css")

block content
  #state-envelope.state-screen
    #envelope-scene.envelope-scene
      #envelope-scale-box.envelope-scale-box
        #envelope-wrapper.envelope-wrapper.is-locked(role="button" aria-label="Open this letter" tabindex="0")
          .envelope-body
            .env-texture
            #env-flap.env-flap
            #env-seal.env-seal
              svg(viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg")
                defs
                  clipPath#sealPhotoClip
                    circle(cx="36" cy="36" r="25")
                circle(cx="36" cy="36" r="34" fill="var(--seal-bg)" opacity="0.1")
                circle(cx="36" cy="36" r="29" fill="var(--seal-inner)")
                circle(cx="36" cy="36" r="27" fill="var(--seal-bg)")
                circle(cx="36" cy="36" r="25" fill="var(--seal-accent)" opacity="0.4")
                image(href=sealUrl x="11" y="11" width="50" height="50" clip-path="url(#sealPhotoClip)" preserveAspectRatio="xMidYMid slice")
                circle(cx="36" cy="36" r="25" fill="var(--seal-accent)" opacity="0.15")
                ellipse(cx="29" cy="27" rx="8" ry="5" fill="white" opacity="0.13" transform="rotate(-35 29 27)")
                circle(cx="36" cy="36" r="21" fill="none" stroke="white" stroke-width="0.9" opacity="0.25")
                circle(cx="36" cy="36" r="18" fill="none" stroke="white" stroke-width="0.4" opacity="0.15")
            .env-folds
              .env-fold-left
              .env-fold-right
            .env-bottom-fold
            .env-letter-peek
              .env-letter-lines
                span
                span
                span
              .env-letter-heart ♥
            .env-recipient
              span.env-to-label= config.envelope.label
              span#env-to-name.env-to-name= config.envelope.name
            #env-stamp.env-stamp
              svg(width="22" height="22" viewBox="0 0 22 22" fill="none")
                path(d="M11 3 L13 8 L18 8 L14 11.5 L15.5 17 L11 13.5 L6.5 17 L8 11.5 L4 8 L9 8 Z" fill="var(--seal-bg)")

      #lock-panel.lock-panel
        #lock-ornament.lock-ornament
          svg(width="28" height="32" viewBox="0 0 28 32" fill="none")
            rect(x="5" y="14" width="18" height="15" rx="3" fill="none" stroke="var(--seal-bg)" stroke-width="1.5" opacity="0.7")
            path(d="M8 14V10C8 6.69 10.69 4 14 4C17.31 4 20 6.69 20 10V14" stroke="var(--seal-bg)" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.7")
            circle(cx="14" cy="21" r="2" fill="var(--seal-bg)" opacity="0.6")
            line(x1="14" y1="23" x2="14" y2="26" stroke="var(--seal-bg)" stroke-width="1.5" stroke-linecap="round" opacity="0.5")
          .lock-divider
        form.password-form(action="/login" method="POST" autocomplete="off")
          label.input-label(for="password") enter the secret word
          input#password(type="text" name="password" placeholder="✦ password ✦" autocapitalize="off" autocorrect="off" spellcheck="false" required)
          if error
            p.password-error(dir="rtl")= error
          button.login-btn(type="submit") 💕 Unlock 💕
        p#envelope-hint.envelope-hint.hidden
          span(aria-hidden="true") ❦
          |  tap to open
          span(aria-hidden="true") ❦

block scripts
  script(src="/js/login.js")
